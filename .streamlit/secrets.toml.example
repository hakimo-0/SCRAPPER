# Copy this file to .streamlit/secrets.toml and add your real SerpAPI key.
# Get it from https://serpapi.com/manage-api-key
SERPAPI_KEY = "your_serpapi_private_key"

# Optional direct Google Workspace integration for this local app.
# Create an OAuth 2.0 Web application client in Google Cloud Console.
# Add http://localhost:8501/ as an authorized redirect URI and configure the
# OAuth consent screen/test users and the Sheets, Docs, Drive, and Gmail APIs.
# Never commit the real secrets.toml file.
[google]
client_id = ""
client_secret = ""
redirect_uri = "http://localhost:8501/"
spreadsheet_id = ""
sheet_name = "BEWERBUNG"
template_doc_id = ""
static_pdf_id = ""
sender_name = ""
